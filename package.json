{
  "name": "dsh-apple-hig",
  "version": "0.9.6",
  "type": "module",
  "description": "L0–L3 + 会话区拖拽重排（表现层，纯核心可单测）的 Apple HIG 校正层",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "apple",
    "hig",
    "design",
    "accessibility"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "tools/contrast.mjs",
    "README.md",
    "LICENSE",
    "install.mjs",
    "test/boot-smoke.mjs",
    "tools/palette.json",
    "test/run-drag-fixture.mjs",
    "test/drag-fixture.html",
    "DRAG-ENGINE.md",
    "test/unit-drag-core.mjs"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node test/boot-smoke.mjs",
    "check:contrast": "node tools/contrast.mjs",
    "test:drag": "node test/run-drag-fixture.mjs",
    "test:unit": "node test/unit-drag-core.mjs",
    "test:boot": "node test/boot-smoke.mjs",
    "test": "node test/unit-drag-core.mjs && node test/boot-smoke.mjs && node test/run-drag-fixture.mjs && node test/run-drag-fixture.mjs test/chrome-fixture.html",
    "test:tabs": "node test/run-drag-fixture.mjs test/chrome-fixture.html"
  },
  "author": "Ne_Rn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yu-jianhai/dsh-apple-hig.git"
  },
  "homepage": "https://github.com/Yu-jianhai/dsh-apple-hig#readme",
  "bugs": {
    "url": "https://github.com/Yu-jianhai/dsh-apple-hig/issues"
  }
}
